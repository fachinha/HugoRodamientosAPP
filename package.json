{
  "name": "rodamientos-hugo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sistema de inventario, punto de venta y alertas de stock para Rodamientos Hugo",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:demo": "wrangler d1 migrations apply DB --remote --env demo",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env production",
    "db:seed-demo:local": "wrangler d1 execute DB --local --file=./scripts/seed-demo.sql",
    "db:seed-demo:remote": "wrangler d1 execute DB --remote --env demo --file=./scripts/seed-demo.sql",
    "db:backup:prod": "node ./scripts/backup.mjs production",
    "db:verify:local": "wrangler d1 execute DB --local --file=./scripts/verify-consistency.sql",
    "deploy:demo": "npm run build && wrangler deploy --env demo",
    "deploy:prod": "npm run build && wrangler deploy --env production"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "hono": "^4.13.14",
    "lucide-react": "^1.61.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "read-excel-file": "^9.3.12",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "workerd@1.20261019.1": true
  }
}

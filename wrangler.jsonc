{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker único: sirve la SPA (static assets) y la API (/api/*) desde el mismo origen.
  "name": "rodamientos-hugo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "local",
    "SESSION_TTL_HOURS": "12"
  },
  // Entorno local (Miniflare). El database_id local no apunta a ninguna base remota.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rodamientos-hugo-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    // Base de demostración: puede contener datos DEMO- sembrados. Nunca usar con datos reales.
    "demo": {
      "name": "rodamientos-hugo-demo",
      "vars": { "APP_ENV": "demo", "SESSION_TTL_HOURS": "12" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rodamientos-hugo-demo",
          "database_id": "REEMPLAZAR-CON-ID-DE-D1-DEMO",
          "migrations_dir": "migrations"
        }
      ]
    },
    // Producción: nunca se siembran datos de demostración.
    "production": {
      "name": "rodamientos-hugo",
      "vars": { "APP_ENV": "production", "SESSION_TTL_HOURS": "12" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rodamientos-hugo-prod",
          "database_id": "ac7c8cea-16c7-496e-b8e1-f4714e28b57a",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
